# PostgreSQL connection
DATABASE_URL=postgresql://blog_user:blog_password@localhost:5432/blog_db

# JWT auth
SECRET_KEY=change-this-to-a-long-random-secret-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App
PROJECT_NAME=Blog Platform API
DEBUG=True

# Comma-separated allowed origins for CORS, or "*" for all (dev only)
CORS_ORIGINS=*
